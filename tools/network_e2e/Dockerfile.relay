# syntax=docker/dockerfile:1
# Disposable relay-only packet-capture/game fixture. Never used by the shipped client.
FROM debian:bookworm-slim
RUN --mount=type=secret,id=ca,required=true \
    apt-get -o Acquire::https::CaInfo=/run/secrets/ca update && \
    apt-get -o Acquire::https::CaInfo=/run/secrets/ca install -y --no-install-recommends \
      wireguard-tools wireguard-go iproute2 iptables python3 python3-cryptography \
      tcpdump openttd openttd-opengfx ca-certificates && \
    rm -rf /var/lib/apt/lists/*
CMD ["sleep", "infinity"]

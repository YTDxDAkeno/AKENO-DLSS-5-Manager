__pycache__/
*.py[cod]
.pytest_cache/
build/
dist/
*.spec.bak
.venv/
venv/
*.egg-info/
packaging/out/
packaging/akeno.ico
screenshots/raw/
packaging/version_info.txt
packaging/akeno-256.png

# User-supplied proprietary runtimes and private build outputs must never enter Git.
runtimes/**/*.dll
runtimes/**/*.bin
runtimes/**/*.zip
runtimes/**/*.exe
dist-private/
private-inputs/

# CI-generated redistributable components: release assets, never binary Git history.
akeno/data/community/dependencies/
community-build/

# Licensing server: secrets, keys, local databases and backups never enter Git.
deploy/.env
deploy/*.env
!deploy/.env.example
deploy/data/
deploy/backups/
server/*.sqlite3
server/**/keys/
*.ed25519.pem

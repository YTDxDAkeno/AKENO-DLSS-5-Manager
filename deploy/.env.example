# AKENO licensing server configuration. install.sh copies this file to .env and fills in the secrets.
# .env holds secrets: it is in .gitignore and readable only by its owner (chmod 600). Never commit it.

COMPOSE_PROJECT_NAME=akeno-licensing
AKENO_ENVIRONMENT=production

# Your host names (set them; nothing is configured for you). AKENO_PUBLIC_URL is used in e-mail links.
AKENO_PUBLIC_URL=
AKENO_ADMIN_URL=
# Only for the optional built-in Caddy (docker compose --profile caddy): host names without https://
AKENO_PUBLIC_HOST=
AKENO_ADMIN_HOST=

# Where the services listen for the reverse proxy. Keep 127.0.0.1 unless the proxy is on another machine.
AKENO_BIND=127.0.0.1
AKENO_API_PORT=8410
AKENO_WEB_PORT=8411
AKENO_ADMIN_PORT=8412

# Database (inside this project only; never exposed). install.sh generates the password.
POSTGRES_DB=akeno
POSTGRES_USER=akeno
POSTGRES_PASSWORD=

# Secrets, generated by install.sh (at least 32 characters each).
# AKENO_TOKEN_SECRET signs sign-in tokens; changing it signs everybody out.
# AKENO_CODE_PEPPER protects activation codes; NEVER change it: every unused code would stop working.
AKENO_TOKEN_SECRET=
AKENO_CODE_PEPPER=

# E-mail: smtp (any provider), file (writes .eml files into the akeno-mail volume) or console (the log).
AKENO_MAIL_BACKEND=file
AKENO_MAIL_FROM=AKENO <no-reply@localhost>
AKENO_SMTP_HOST=
AKENO_SMTP_PORT=587
AKENO_SMTP_USER=
AKENO_SMTP_PASSWORD=
AKENO_SMTP_SECURITY=starttls

# Where AKENO is downloaded: the public release repository (the source repository is private).
AKENO_DOWNLOAD_URL=https://github.com/YTDxDAkeno/AKENO-Releases/releases/latest

# Backups (pg_dump of the database plus the signing keys), kept in the akeno-backups volume.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
